[Unit]
Description=AllBox ESP32 shell STL web generator
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/AllBox/webapp
Environment=OPENSCAD_BIN=/usr/local/bin/openscad-nightly
Environment=ESP32_SHELL_CACHE=/var/cache/esp32-shell
CacheDirectory=esp32-shell
ExecStart=/opt/AllBox/.venv/bin/gunicorn --workers 1 --threads 4 --timeout 300 --bind 0.0.0.0:55505 app:app
Restart=on-failure

[Install]
WantedBy=multi-user.target
